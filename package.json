{
  "name": "status-plus",
  "version": "1.0.0",
  "description": "Status+ local project management desktop app with SQLite and RAG Vector Database",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,VITE\" -c \"cyan,magenta\" \"node server/server.js\" \"vite\"",
    "dev:server": "node server/server.js",
    "dev:vite": "vite",
    "build": "vite build",
    "start": "concurrently -k \"node server/server.js\" \"vite\" \"electron .\"",
    "web": "node server/server.js",
    "electron": "electron .",
    "package": "npm run build && electron-builder --win --dir",
    "package:exe": "npm run build && electron-builder --win"
  },
  "keywords": [
    "status-plus",
    "project-management",
    "electron",
    "sqlite",
    "rag"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.46.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.jetmut.statusplus",
    "productName": "Status+",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "uploads/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
